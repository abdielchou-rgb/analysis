{
  "schema_version": "1.0",
  "description": "图表 schema 权威定义（2026-08-01 建立）。各组件（SAC chart_config / chart_pipeline / data_enrichment 白名单）必须与本 schema 对齐。",
  "notes": [
    "fig_type: 图表类型（bar/line/pie/radar/dual_axis/bar_cluster/waterfall/scatter）",
    "data_keys: 该图生成所需的数据键（在 chart_data 中查找），任一存在即可",
    "allowed: 是否允许 agent enrich 注入（enrichment 白名单）",
    "maps_to: 对应 SAC 分析维度",
    "aliases: LLM 写的占位符别名 → 规范图 id（chart_assembler 归一化用）"
  ],
  "aliases": {
    "figrevenuetrend": "revenue_structure",
    "figrevenue": "revenue_structure",
    "figbusinesssegments": "revenue_structure",
    "figprofitability": "profit_margin",
    "figprofit": "profit_margin",
    "figgrossmargin": "profit_margin",
    "figpeercomparison": "valuation_peers",
    "figvaluation": "valuation_peers",
    "figpeers": "valuation_peers",
    "figmarketposition": "market_position",
    "figindustryboard": "market_position",
    "figmarketshare": "market_position",
    "figcapitalflow": "financial_trends",
    "figfinancialtrends": "financial_trends",
    "figfinancial": "financial_trends",
    "figmarketsize": "market_size",
    "figmarketsizeglobal": "market_size",
    "figmarketsizechina": "market_size",
    "figmarket": "market_size",
    "figsize": "market_size",
    "figcompetitivelandscape": "competitive_landscape",
    "figcompetition": "competitive_landscape",
    "figindustrychain": "industry_chain",
    "figsupplychain": "industry_chain",
    "figtechtrend": "tech_trend",
    "figtechnology": "tech_trend",
    "figpolicyimpact": "policy_impact",
    "figpolicy": "policy_impact",
    "figapplications": "market_size",
    "figgrowthdrivers": "growth_drivers"
  },
