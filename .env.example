# 复制为 .env 并填入真实值（.env 不入库）
# ==========================================
# P0 主力：DeepSeek（付费，扛关键链）
DEEPSEEK_API_KEY=sk-xxxx
# P1 兜底+圆桌：OpenRouter（付费，降级/异源终审）
OPENROUTER_API_KEY=sk-or-v1-xxxx
# OpenRouter 模型列表（逗号分隔，圆桌异源用）
OPENROUTER_MODELS=deepseek/deepseek-v4-flash,deepseek/deepseek-chat,qwen/qwen3.6-flash
# 可选：WebSearch 兜底
TAVILY_API_KEY=tvly-xxxx

# ==========================================
# 运行时配置（可选，有默认值）
# 主 LLM provider（deepseek / agent_provider / openrouter）
LLM_PROVIDER=deepseek
# 运行模式（perf 性能 / train 训练）
RUN_MODE=perf
# 修订循环上限
MAX_ATTEMPTS=3
# 语义早停相似度阈值（0.9=内容不再变化即收敛停止）
EARLY_STOP_SIMILARITY=0.90
# 门禁熔断：同一失败项修复 N 次仍不过 → 降级全量重写
REPAIR_CIRCUIT_BREAK=3
# LLM HTTP 超时（秒）
LLM_HTTP_TIMEOUT=90
# Marvis 免费预取开关（responder 在线时设 1）
MARVIS_PREFETCH=0
# 终局圆桌走 OpenRouter 异源
CRITIC_HETEROSOURCE=0
# 柔性定制需求（如"侧重并购的尽调报告"）
CUSTOM_REQUIREMENT=
